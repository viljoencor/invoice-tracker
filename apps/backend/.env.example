# Environment Configuration
ENVIRONMENT=development  # Options: development, staging, production

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/invoicer
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true

# Security Configuration
# WARNING: In production, use a strong random secret (minimum 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=_Bk2swV-irvgVGswT169WWh4ty2DFVgvTS9q3_KtlHo
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Logging Configuration
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_JSON_FORMAT=false  # Set to true for production JSON logging
